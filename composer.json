{
    "name": "masilia/ai-assistant",
    "description": "AI Content Assistant for Ibexa CMS — streaming suggestions, translation, quick actions",
    "type": "ibexa-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "Masilia Team",
            "email": "dev@masilia.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-intl": "*",
        "ext-dom": "*",
        "ibexa/core": "^4.6",
        "ibexa/admin-ui": "^4.6",
        "ibexa/automated-translation": "^4.6",
        "ibexa/fieldtype-matrix": "^4.6",
        "doctrine/orm": "^2.13",
        "doctrine/doctrine-bundle": "^2.7",
        "knplabs/knp-menu": "^3.3",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/config": "^5.4 || ^6.4",
        "symfony/console": "^5.4 || ^6.4",
        "symfony/dependency-injection": "^5.4 || ^6.4",
        "symfony/event-dispatcher": "^5.4 || ^6.4",
        "symfony/framework-bundle": "^5.4 || ^6.4",
        "symfony/http-client": "^5.4 || ^6.4",
        "symfony/http-foundation": "^5.4 || ^6.4",
        "symfony/http-kernel": "^5.4 || ^6.4",
        "symfony/routing": "^5.4 || ^6.4",
        "symfony/security-core": "^5.4 || ^6.4",
        "symfony/yaml": "^5.4 || ^6.4",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Masilia\\Bundle\\AiAssistant\\": "src/bundle",
            "Masilia\\AiAssistant\\": "src/lib"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Masilia\\AiAssistant\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "phpunit": "phpunit",
        "test": [
            "@phpunit",
            "@phpstan"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
