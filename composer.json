{
    "name": "masilia/ai-assistant",
    "description": "AI Content Assistant for Ibexa CMS — streaming suggestions, translation, quick actions",
    "type": "ibexa-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "Masilia Team",
            "email": "dev@masilia.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ibexa/core": "^4.6",
        "ibexa/admin-ui": "^4.6",
        "doctrine/orm": "^2.13",
        "doctrine/doctrine-bundle": "^2.7",
        "symfony/http-client": "^5.4",
        "symfony/routing": "^5.4",
        "symfony/form": "^5.4",
        "symfony/console": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "Masilia\\Bundle\\AiAssistant\\": "src/bundle",
            "Masilia\\AiAssistant\\": "src/lib"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Masilia\\AiAssistant\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    }
}
